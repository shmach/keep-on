{
  "manifest_version": 3,
  "name": "Focus Alarm",
  "version": "1.0.0",
  "description": "Stay focused with smart distraction detection. Alarm on blacklisted sites after a grace period.",
  "permissions": ["tabs", "storage", "alarms", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Focus Alarm"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/overlay.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options/options.html",
  "commands": {
    "toggle-session": {
      "suggested_key": {
        "default": "Alt+F"
      },
      "description": "Toggle focus session on/off"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
